<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>AgentKick75.Hook</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentKick75.App\AgentKick75.App.csproj" />
  </ItemGroup>

  <Target Name="CopyHookHelperToAppOutput" AfterTargets="Build">
    <ItemGroup>
      <HookHelperArtifacts Include="$(TargetDir)AgentKick75.Hook.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(HookHelperArtifacts)"
      DestinationFolder="..\AgentKick75.App\bin\$(Configuration)\$(TargetFramework)\"
      SkipUnchangedFiles="true" />
  </Target>
</Project>
